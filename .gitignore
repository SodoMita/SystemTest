# Editor / app working & backup files
*~
*.bak
*.swp
*.tmp

# Blender working/backup files (keep .blend source, drop autosaves)
*.blend1
*.blend2

# Krita working files
*.kra
*.kra~

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Audio formats Luanti cannot use (only .ogg is supported)
*.aac
*.mp3
*.mp4
*.wav
*.flac

# Luanti world/runtime data
/worlds/
/saves/
debug.txt

# Compiled pipeline binaries (sources stay, binaries rebuild per-session)
mods/content/sl_scary/pipeline/downscale_filter
mods/content/sl_scary/pipeline/matte_floodfill

# Python bytecode
__pycache__/
*.pyc

# AI-art scratch attempts (regenerable grid sources; not game assets).
# Game assets are committed in textures/; these are the working renders.
/.art/
